# Copy to .env and replace every change-me value before running.
# Keep .env out of Git. Prefer build-containers.ps1 init to generate random secrets.
IP_ADDRESS=127.0.0.1
SPRING_BOOT_PORT=8081
MARIADB_PORT=3307
MARIADB_DBS=ntt_university
MARIADB_USERNAME=root
MARIADB_PASSWORD=change-me-use-a-strong-random-password
REDIS_PORT=6380
REDIS_USERNAME=default
REDIS_PASSWORD=change-me-use-a-different-strong-random-password
REDIS_DBS=1
TOTP_MASTER_KEY_V2=change-me-base64-32-random-bytes
JWT_SECRET_BASE64=change-me-base64-32-different-random-bytes
CORS_ALLOWED_ORIGINS=http://localhost:5374,http://localhost:5375,http://localhost:5173
AUTH_COOKIE_SECURE=false
JPA_DDL_AUTO=update
